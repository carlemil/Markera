*.iml
.gradle/
.kotlin/
/local.properties
.idea/
.DS_Store
build/
/captures
.externalNativeBuild
.cxx
local.properties

# Kotlin/Native + Xcode artefacts
xcuserdata/
*.xcworkspace/xcuserdata/

# ONNX model — excluded from version control (~40 MB).
# Drop best.onnx into composeApp/src/androidMain/assets/ before building
# for Android. See README.md for details.
composeApp/src/androidMain/assets/*.onnx
# Model backups must never live under assets/ (they'd be packaged into the APK);
# a safety net for any manual .bak that lands here.
composeApp/src/androidMain/assets/*.bak

# Release signing + Play API credentials (never commit)
keystore.properties
/keystore
*.jks
*.keystore
play-account.json

# iOS: the Xcode project is generated by xcodegen from iosApp/project.yml;
# Local.xcconfig carries the developer team id (see Local.xcconfig.example).
iosApp/iosApp.xcodeproj/
iosApp/build/
iosApp/Config/Local.xcconfig
# fastlane: the App Store Connect key + env stay local
iosApp/fastlane/.env
iosApp/fastlane/*.p8
iosApp/fastlane/report.xml
iosApp/fastlane/README.md
iosApp/fastlane/Preview.html
# generated by xcodegen from project.yml / downloaded by fastlane cert + sigh
iosApp/iosApp/Info.plist
iosApp/iosApp/iosApp.entitlements
iosApp/*.cer
iosApp/*.mobileprovision
