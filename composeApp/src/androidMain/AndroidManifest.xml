<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- The portrait lock below would otherwise imply this as required and hide the app from tablets, Chromebooks and XR. -->
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <application
        android:name=".MarkeraApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Markera">
        <!-- Sentry is started by hand in MarkeraApplication (DSN from BuildConfig), not by its provider. -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Markera">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Where the backend sends the browser when Sign in with Apple is done: a verified App Link on
                 the backend host (markera.backend.url, via manifestPlaceholders), which no other app can
                 claim once the server's /.well-known/assetlinks.json lists this app's signing key. singleTop
                 above matters: a second activity instance would lose the waiting AppleReturn. Its own
                 filter: <data> elements in one filter cross-multiply. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="https"
                    android:host="${appleReturnHost}"
                    android:path="/auth/apple/done" />
            </intent-filter>

            <!-- The old return, kept for backends that predate the https one and for the done page's
                 fallback button; any app can register this scheme (issue #48). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:scheme="markera"
                    android:host="auth"
                    android:path="/apple" />
            </intent-filter>
        </activity>

        <!-- Hands the Historik export zip (cacheDir/export) to the share chooser. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>