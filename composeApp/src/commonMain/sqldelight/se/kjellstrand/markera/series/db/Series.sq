-- The local read cache for the Markera backend. `json` is the
-- whole SeriesDto; `timestamp` beside it only orders the rows without decoding. `sync` holds the one `updatedAt` stamp the delta refresh sends back,
-- keyed by the user it belongs to so another login is detected and wiped.

CREATE TABLE series (
    id INTEGER NOT NULL PRIMARY KEY,
    timestamp TEXT NOT NULL,
    json TEXT NOT NULL
);

CREATE TABLE sync (
    user_id TEXT NOT NULL PRIMARY KEY,
    last_sync TEXT NOT NULL
);

-- Committed series the server has not taken yet (offline, 5xx), kept until a refresh sends them, so
-- the next scan can never be what loses one. `series_id` is set once the POST went through and only
-- the photo is left; `request` is the SeriesRequest JSON (its clientId makes a re-POST harmless).
CREATE TABLE outbox (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id TEXT NOT NULL,
    request TEXT NOT NULL,
    series_id INTEGER,
    image BLOB,
    image_width INTEGER,
    image_height INTEGER
);

CREATE TABLE local_series (
    local_id INTEGER PRIMARY KEY AUTOINCREMENT,
    client_id TEXT NOT NULL UNIQUE,
    owner_user_id TEXT,
    request TEXT NOT NULL,
    server_id INTEGER,
    image_width INTEGER,
    image_height INTEGER,
    has_image INTEGER NOT NULL DEFAULT 0,
    state TEXT NOT NULL DEFAULT 'queued',
    last_status INTEGER,
    reported INTEGER NOT NULL DEFAULT 0,
    created_at TEXT NOT NULL
);
selectAll:
SELECT id, json FROM series ORDER BY timestamp DESC;

upsert:
INSERT OR REPLACE INTO series(id, timestamp, json) VALUES (?, ?, ?);

deleteById:
DELETE FROM series WHERE id = ?;

deleteAllSeries:
DELETE FROM series;

lastSync:
SELECT user_id, last_sync FROM sync LIMIT 1;

setLastSync:
INSERT OR REPLACE INTO sync(user_id, last_sync) VALUES (?, ?);

clearSync:
DELETE FROM sync;

enqueue:
INSERT INTO outbox(user_id, request, series_id, image, image_width, image_height) VALUES (?, ?, ?, ?, ?, ?);

outboxFor:
SELECT * FROM outbox WHERE user_id = ? ORDER BY id;

outboxPosted:
UPDATE outbox SET series_id = ? WHERE id = ?;

outboxDone:
DELETE FROM outbox WHERE id = ?;

selectLocal:
SELECT * FROM local_series ORDER BY local_id;

localById:
SELECT * FROM local_series WHERE local_id = ?;

localByClient:
SELECT * FROM local_series WHERE client_id = ?;

insertLocal:
INSERT OR IGNORE INTO local_series(client_id, owner_user_id, request, image_width, image_height, has_image, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

localPhoto:
UPDATE local_series SET has_image = 1, image_width = ?, image_height = ? WHERE local_id = ?;

localPosted:
UPDATE local_series SET server_id = ? WHERE local_id = ?;

localFailure:
UPDATE local_series SET state = ?, last_status = ?, reported = ? WHERE local_id = ?;

editLocal:
UPDATE local_series SET request = ? WHERE local_id = ?;

removeLocal:
DELETE FROM local_series WHERE local_id = ?;

-- A row another account's server already acknowledged (only its photo pending) stays with
-- that account: posting it again to the new one would copy the series across accounts.
claimOffered:
UPDATE local_series SET owner_user_id = ?, state = 'queued', last_status = NULL
WHERE (owner_user_id IS NULL OR owner_user_id != ?) AND server_id IS NULL;

allOutbox:
SELECT * FROM outbox ORDER BY id;
