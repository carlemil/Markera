    <string name="advice_cause_diagonal_1">握力和扣扳机的力相互抵触。</string>
    <string name="advice_cause_diagonal_2">站姿或手臂姿势让枪倾斜。</string>
    <string name="advice_try_diagonal">确认每发的握法一致，扣扳机前瞄具保持水平。</string>
