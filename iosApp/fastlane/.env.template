# Copy to iosApp/fastlane/.env (gitignored) and fill in. Never commit the .p8.
ASC_KEY_ID=ABCDE12345
ASC_ISSUER_ID=12345678-1234-1234-1234-123456789012
ASC_KEY_PATH=/absolute/path/to/AuthKey_ABCDE12345.p8
FASTLANE_TEAM_ID=BSZST7M33J
# Keychain holding the Apple Distribution identity for codesign over ssh:
#   security create-keychain -p <pw> ~/Library/Keychains/markera-build.keychain-db
#   security set-keychain-settings ~/Library/Keychains/markera-build.keychain-db   # never auto-lock
#   security list-keychains -d user -s ~/Library/Keychains/markera-build.keychain-db ~/Library/Keychains/login.keychain-db
# `fastlane beta` then creates/imports the certificate into it.
BUILD_KEYCHAIN_PATH=/Users/me/Library/Keychains/markera-build.keychain-db
BUILD_KEYCHAIN_PASSWORD=change-me
