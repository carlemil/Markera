default_platform(:ios)
opt_out_usage

# fastlane auto-loads iosApp/fastlane/.env (gitignored): ASC_KEY_ID,
# ASC_ISSUER_ID, ASC_KEY_PATH, FASTLANE_TEAM_ID — see .env.template.
# Same shape as FieldShootingTimer's lane; the ASC key is per team, so that
# project's key works here too once the Markera app record exists.

APP_ID = "se.kjellstrand.markera"

platform :ios do
  desc "Regenerate iosApp.xcodeproj from project.yml (idempotent)."
  lane :gen do
    sh("cd .. && DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer xcodegen generate")
  end

  private_lane :asc_key do
    app_store_connect_api_key(
      key_id:       ENV.fetch("ASC_KEY_ID"),
      issuer_id:    ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: ENV.fetch("ASC_KEY_PATH"),
      in_house:     false,
    )
  end

  desc "Print the newest TestFlight build number."
  lane :latest do
    UI.success("Latest TestFlight build: #{latest_testflight_build_number(api_key: asc_key, app_identifier: APP_ID)}")
  end

  desc "Build a signed App Store archive and upload it to TestFlight."
  lane :beta do
    gen
    api_key = asc_key
    get_certificates(api_key: api_key)
    # The archive entitles Sign in with Apple, so the App ID must carry that
    # capability; a profile created before it did has to be regenerated.
    bundle = Spaceship::ConnectAPI::BundleId.find(APP_ID)
    added = bundle.get_capabilities.none? { |c| c.capability_type == "APPLE_ID_AUTH" }
    if added
      UI.important("Enabling Sign in with Apple on #{APP_ID}")
      bundle.create_capability(
        Spaceship::ConnectAPI::BundleIdCapability::Type::APPLE_ID_AUTH,
        settings: [{ key: "APPLE_ID_AUTH_APP_CONSENT", options: [{ key: "PRIMARY_APP_CONSENT" }] }],
      )
    end
    get_provisioning_profile(api_key: api_key, app_identifier: APP_ID, force: added)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # CURRENT_PROJECT_VERSION in project.yml mirrors the Android versionCode;
    # ASC rejects a build number <= any already uploaded, so bump past it.
    latest = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID).to_i
    build_number = ENV["BUILD_NUMBER"] || `grep CURRENT_PROJECT_VERSION ../project.yml`[/\d+/]
    build_number = (latest + 1).to_s if build_number.to_i <= latest
    UI.message("Using build number #{build_number}")

    build_app(
      # Local.xcconfig keeps automatic signing for simulator builds; the archive
      # needs manual signing with the profile sigh just resolved.
      xcargs: %(CURRENT_PROJECT_VERSION=#{build_number} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="Apple Distribution" PROVISIONING_PROFILE_SPECIFIER="#{profile_name}"),
      export_options: {
        method:               "app-store",
        signingStyle:         "manual",
        teamID:               ENV.fetch("FASTLANE_TEAM_ID"),
        uploadSymbols:        true,
        provisioningProfiles: { APP_ID => profile_name },
      },
    )
    upload_to_testflight(
      api_key:                           api_key,
      skip_waiting_for_build_processing: true,
      changelog:                         File.read("metadata/sv/release_notes.txt").strip,
    )
  end

  # deliver reads Deliverfile + metadata/ + screenshots/ (device inferred from
  # the image size). The App Store version string follows project.yml.
  private_lane :push_listing do |options|
    api_key = asc_key
    version = `grep MARKETING_VERSION ../project.yml`[/[\d.]+/]
    build = latest_testflight_build_number(api_key: api_key, app_identifier: APP_ID).to_s
    submit = options[:submit]
    UI.message("App Store version #{version}, build #{build}, submit=#{submit}")
    # Both are app-level and required before a submission is accepted; deliver
    # sets neither. The privacy action publishes the answers as well.
    Spaceship::ConnectAPI::App.find(APP_ID).update(attributes: { contentRightsDeclaration: "DOES_NOT_USE_THIRD_PARTY_CONTENT" })
    upload_app_privacy_details(api_key: api_key, app_identifier: APP_ID, json_path: "fastlane/app_privacy_details.json")
    upload_to_app_store(
      api_key:               api_key,
      app_version:           version,
      build_number:          build,
      skip_binary_upload:    true,
      overwrite_screenshots: true,
      submit_for_review:     submit,
      automatic_release:     false,
      submission_information: {
        add_id_info_uses_idfa:            false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false,
      },
    )
    dedupe_screenshots
  end

  # deliver uploads the screenshot set, re-reads it before ASC has indexed the
  # new assets, reports every file "missing", and re-uploads — so the set lands
  # doubled (seen on FieldShootingTimer and on Markera 1.5.0). Clean up after.
  desc "Delete duplicate screenshots (same file name twice in a set) on the editable version."
  lane :dedupe_screenshots do
    asc_key
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    version = app.get_edit_app_store_version(platform: "IOS")
    UI.user_error!("No editable App Store version") unless version
    deleted = 0
    version.get_app_store_version_localizations.each do |loc|
      loc.get_app_screenshot_sets.each do |set|
        seen = {}
        set.app_screenshots.each do |shot|
          if seen[shot.file_name]
            shot.delete!
            deleted += 1
          else
            seen[shot.file_name] = true
          end
        end
        UI.message("#{loc.locale} #{set.screenshot_display_type}: #{set.app_screenshots.size - deleted} kept")
      end
    end
    UI.success("Removed #{deleted} duplicate screenshot(s)")
  end

  desc "Push App Store metadata + screenshots to the editable version (no submit)."
  lane :metadata do
    push_listing(submit: false)
  end

  desc "Metadata + screenshots, attach the newest TestFlight build and submit for review."
  lane :release do
    push_listing(submit: true)
  end
end
