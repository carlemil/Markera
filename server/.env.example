GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
DEV_AUTH=false
# HTTP Basic (user `admin`) for the read-only /admin pages; blank leaves them unregistered.
ADMIN_PASSWORD=change-me

# Sign in with Apple from a browser — how Android reaches it (Apple ships no Android SDK, and the
# flow's client secret must not live in an APK). All five or none; missing any leaves
# /auth/apple/start, /callback and /claim answering 503. Set up in the Apple Developer portal:
# a Services ID whose Primary App ID is the iOS bundle id (otherwise Android lands on a different
# account from the iPhone), its Return URL exactly $PUBLIC_URL/auth/apple/callback, and a
# Sign-in-with-Apple key (.p8).
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 on one line, header optional: grep -v -- '-----' AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APPLE_PRIVATE_KEY=
PUBLIC_URL=https://markera.duckdns.org

# The app's suggestion box (POST /suggestions): each suggestion is stored (see /admin/suggestions) and, when
# SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set, mailed to SUGGESTIONS_TO with Reply-To = the sender's
# address (if they gave one). Gmail: smtp.gmail.com:587 and an app password (Google account -> Security ->
# 2-Step Verification -> App passwords), never the account password. Port 465 switches to implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUGGESTIONS_TO=erbsman@gmail.com
