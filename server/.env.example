GOOGLE_CLIENT_ID=
APPLE_BUNDLE_ID=
DEV_AUTH=false
# HTTP Basic (user `admin`) for the read-only /admin pages; blank leaves them unregistered.
ADMIN_PASSWORD=change-me

# Sign in with Apple from a browser — how Android reaches it (Apple ships no Android SDK, and the
# flow's client secret must not live in an APK). All five or none; missing any leaves
# /auth/apple/start, /callback and /claim answering 503. Set up in the Apple Developer portal:
# a Services ID whose Primary App ID is the iOS bundle id (otherwise Android lands on a different
# account from the iPhone), its Return URL exactly $PUBLIC_URL/auth/apple/callback, and a
# Sign-in-with-Apple key (.p8).
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The .p8 on one line, header optional: grep -v -- '-----' AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
APPLE_PRIVATE_KEY=
PUBLIC_URL=https://markera.duckdns.org
# The file Apple fetches at /.well-known/apple-developer-domain-association.txt to verify the domain, if Apple
# issues one (it is not in git). Blank = beside DB_PATH, i.e.
# /data/apple-developer-domain-association.txt in the Docker volume. Missing file = 404.
APPLE_DOMAIN_ASSOCIATION_FILE=

# Android's Sign in with Apple returns through the verified App Link $PUBLIC_URL/auth/apple/done, which Android
# checks against /.well-known/assetlinks.json (built from these two). Blank ANDROID_CERT_SHA256 answers that file
# with 404: nothing verifies and the app falls back to the /auth/apple/done page's buttons.
ANDROID_PACKAGE=se.kjellstrand.markera
# Comma-separated SHA-256 fingerprints (AA:BB:..., 32 bytes; not the SHA-1) of every key that signs an installed
# build: Play Console -> Test and release -> App integrity -> App signing -> "App signing key certificate" SHA-256,
# plus the upload key's and the debug keystore's for sideloaded builds (./gradlew :composeApp:signingReport).
ANDROID_CERT_SHA256=

# The app's suggestion box (POST /suggestions): each suggestion is stored (see /admin/suggestions) and, when
# SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set, mailed to SUGGESTIONS_TO with Reply-To = the sender's
# address (if they gave one). Gmail: smtp.gmail.com:587 and an app password (Google account -> Security ->
# 2-Step Verification -> App passwords), never the account password. Port 465 switches to implicit TLS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SUGGESTIONS_TO=erbsman@gmail.com

# Quotas for all users together (defaults shown). New series per 24 h; photo MB per UTC day; photo uploads
# answer 507 while the images disk has less than MIN_FREE_DISK_MB free.
MAX_SERIES_PER_DAY_ALL=2000
MAX_PHOTO_MB_PER_DAY_ALL=5120
MIN_FREE_DISK_MB=2048
